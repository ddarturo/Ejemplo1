{
  "name": "paginacristianoronaldo",
  "version": "1.0.0",
  "description": "Este proyecto es una primera versión de una página web estática en español sobre Cristiano Ronaldo, desarrollada con HTML semántico, CSS y JavaScript vanilla sin frameworks ni backend.",
  "main": "script.js",
  "scripts": {
    "lint:html": "htmlhint \"index.html\"",
    "validate:html": "node scripts/check-html5.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:responsive": "node scripts/check-responsive.mjs",
    "serve": "http-server . -p 8080",
    "test": "npm run lint:html && npm run validate:html && npm run check:links && npm run check:responsive"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddarturo/Ejemplo1.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ddarturo/Ejemplo1/issues"
  },
  "homepage": "https://github.com/ddarturo/Ejemplo1#readme",
  "devDependencies": {
    "@axe-core/cli": "^4.13.0",
    "browser-driver-manager": "^2.0.1",
    "htmlhint": "^1.9.2",
    "http-server": "^14.1.1"
  }
}
